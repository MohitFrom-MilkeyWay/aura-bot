# Telegram Bot Token from @BotFather (required)
# Single bot:
BOT_TOKEN=your_bot_token_here

# OR multiple bots (1 process = all bots live). Comma-separated:
# BOT_TOKENS=123:AAAxxx,456:BBByyy,789:CCCzzz
# Optional extras:
# BOT_TOKEN_2=
# BOT_TOKEN_3=

# ===== Free LLM (Stage 2) =====
# Option 1 (Recommended - Fast & Free): https://console.groq.com
# Create account → API Keys → Create key → paste below (no quotes)
GROQ_API_KEY=

# Option 2: https://openrouter.ai → Keys
OPENROUTER_API_KEY=

# IMPORTANT:
# - No spaces around =
# - No quotes around the key
# - After editing .env always RESTART the bot
# - Use /status command to verify keys are loaded

# Your Telegram numeric user id (from @userinfobot). Comma-separated for multiple admins.
ADMIN_IDS=123456789

# Bot username without @ (for invite links). Optional – auto-detected if empty.
BOT_USERNAME=
